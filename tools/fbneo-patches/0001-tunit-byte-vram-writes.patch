diff --git a/src/cpu/tms34_intf.h b/src/cpu/tms34_intf.h
index 434885c..fe531f8 100644
--- a/src/cpu/tms34_intf.h
+++ b/src/cpu/tms34_intf.h
@@ -46,6 +46,14 @@ UINT8 TMS34010ReadByte(UINT32 address);
 UINT16 TMS34010ReadWord(UINT32 address);
 void TMS34010WriteByte(UINT32 address, UINT8 value);
 void TMS34010WriteWord(UINT32 address, UINT16 value);
+// Which bytes of the word being written the CPU meant to change, for the
+// duration of one TMS34010WriteWord from a byte-aligned 8-bit pixel or field
+// write (PIXT, DRAV, MOVB); 0xffff otherwise. The core does those as a
+// read-modify-write of the whole word (this interface is word-based), which
+// is the same DATA, but a handler where writing a byte has side effects -
+// Midway T-Unit VRAM stamps each pixel's colour-map selector - must only
+// touch the byte that was meant. Other handlers can ignore it.
+extern UINT16 TMS34010WriteMask;
 void TMS34010MapMemory(UINT8 *mem, UINT32 start, UINT32 end, UINT8 type);
 void TMS34010UnmapMemory(UINT32 start, UINT32 end, UINT8 type);
 void TMS34010MapHandler(uintptr_t num, UINT32 start, UINT32 end, UINT8 type);
