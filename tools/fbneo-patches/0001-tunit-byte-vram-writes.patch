diff --git a/src/burn/drv/midway/midtunit.cpp b/src/burn/drv/midway/midtunit.cpp
index af93a99..d2d33f5 100644
--- a/src/burn/drv/midway/midtunit.cpp
+++ b/src/burn/drv/midway/midtunit.cpp
@@ -464,15 +464,20 @@ static UINT16 TUnitVramRead(UINT32 address)
 static void TUnitVramWrite(UINT32 address, UINT16 data)
 {
 	UINT32 offset = TOBYTE(address & 0x3fffff);
+	// Honour a byte write (TMS34010WriteMask): MAME does, and so does the
+	// board. Without it a single-pixel CPU write (PIXT) re-stamped the
+	// NEIGHBOUR pixel's colour-map selector from DMA_PALETTE, recolouring it
+	// through the wrong palette.
+	const UINT16 mask = TMS34010WriteMask;
 	if (nVideoBank)
 	{
-		DrvVRAM16[offset] = BURN_ENDIAN_SWAP_INT16((data & 0xff) | ((nDMA[DMA_PALETTE] & 0xff) << 8));
-		DrvVRAM16[offset + 1] = BURN_ENDIAN_SWAP_INT16(((data >> 8) & 0xff) | (nDMA[DMA_PALETTE] & 0xff00));
+		if (mask & 0x00ff) DrvVRAM16[offset] = BURN_ENDIAN_SWAP_INT16((data & 0xff) | ((nDMA[DMA_PALETTE] & 0xff) << 8));
+		if (mask & 0xff00) DrvVRAM16[offset + 1] = BURN_ENDIAN_SWAP_INT16(((data >> 8) & 0xff) | (nDMA[DMA_PALETTE] & 0xff00));
 	}
 	else
 	{
-		DrvVRAM16[offset] = BURN_ENDIAN_SWAP_INT16((BURN_ENDIAN_SWAP_INT16(DrvVRAM16[offset]) & 0xff) | ((data & 0xff) << 8));
-		DrvVRAM16[offset + 1] = BURN_ENDIAN_SWAP_INT16((BURN_ENDIAN_SWAP_INT16(DrvVRAM16[offset + 1]) & 0xff) | (data & 0xff00));	
+		if (mask & 0x00ff) DrvVRAM16[offset] = BURN_ENDIAN_SWAP_INT16((BURN_ENDIAN_SWAP_INT16(DrvVRAM16[offset]) & 0xff) | ((data & 0xff) << 8));
+		if (mask & 0xff00) DrvVRAM16[offset + 1] = BURN_ENDIAN_SWAP_INT16((BURN_ENDIAN_SWAP_INT16(DrvVRAM16[offset + 1]) & 0xff) | (data & 0xff00));	
 	}
 }
 
