+// The manifest's magic words (mk2-main src/FPADDR.ASM): F4E5 A9D1 5046 4441.
+static INT32 DetectMk2OnWolf()
+{
+	static const UINT8 magic[8] = { 0xe5, 0xf4, 0xd1, 0xa9, 0x46, 0x50, 0x41, 0x44 };
+	for (INT32 i = 0; i <= 0x100000 - 8; i += 2) {
+		if (memcmp(DrvBootROM + i, magic, sizeof(magic)) == 0) return 1;
+	}
+	return 0;
+}
