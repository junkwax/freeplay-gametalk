@@ -376,9 +389,31 @@ static INT32 LoadSoundBanks()
     if (BurnLoadRom(DrvSoundROM + 0x400000, 4, 2)) return 1;
     if (BurnLoadRom(DrvSoundROM + 0x600000, 5, 2)) return 1;
 
+	// u6-u9, the sound board's spare sockets: optional entries in the romset,
+	// present only in an MK2-on-Wolf set. A missing one stays FF.
+	char *pRomName;
+	struct BurnRomInfo ri;
+	for (INT32 i = 6, n = 0; n < 4 && !BurnDrvGetRomName(&pRomName, i, 0); i++) {
+		BurnDrvGetRomInfo(&ri, i);
+		if ((ri.nType & 7) == 2 && (ri.nType & BRF_OPT)) {
+			BurnLoadRom(DrvSoundROM + 0x800000 + n * 0x200000, i, 2);
+			n++;
+		}
+	}
+
     return 0;
